{
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "jeroendruwe",
  "compatibility_date": "2025-11-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "www.jeroendruwe.be",
      "custom_domain": true
    }
  ]
}