---
import Link from '@/components/Link.astro';
import { formatDateLong, formatDateISO } from '@/lib/utils.ts';
import ArrowRightIcon from '@lucide/astro/icons/arrow-right';

import type { Post } from '@/types.ts';

interface Props {
  entry: Post;
}

const { entry } = Astro.props;
---

<!--transition:name={`post-title-${entry.id}`}-->
<div class="flex flex-col gap-y-2">
  <Link href={`/${entry.collection}/${entry.id}`} underline class="w-fit">
    <h3 class="mb-1 text-xl font-semibold">
      {entry.data.title}
    </h3>
  </Link>
  <time
    class="text-muted-foreground text-sm"
    datetime={formatDateISO(entry.data.pubDate)}
    >{formatDateLong(entry.data.pubDate)}</time
  >
  <p>{entry.data.description}</p>
  <Link
    href={`/${entry.collection}/${entry.id}`}
    underline
    class="group flex w-fit items-center gap-x-1 text-sm"
    tabindex="-1"
  >
    Read more <ArrowRightIcon
      class="text-muted-foreground hidden group-hover:inline"
      size="16"
    /></Link
  >
</div>
