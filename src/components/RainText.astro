---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['rain-text', className]}>
  <slot />
  <span class="droplet" style="--delay: 0s; --left: 10%"></span>
  <span class="droplet" style="--delay: 0.3s; --left: 40%"></span>
  <span class="droplet" style="--delay: 0.6s; --left: 70%"></span>
</span>

<style>
  .rain-text {
    position: relative;
    display: inline-block;
  }

  .droplet {
    position: absolute;
    width: 2px;
    height: 10px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(100, 149, 237, 0.6),
      transparent
    );
    border-radius: 50%;
    animation: rain 1s linear infinite;
    animation-delay: var(--delay);
    left: var(--left);
    opacity: 0;
  }

  @keyframes rain {
    0% {
      top: -15px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }
</style>
