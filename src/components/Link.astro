---
import { cn } from '@/lib/utils';

interface Props {
  href: string;
  external?: boolean;
  class?: string;
  underline?: boolean;
  [key: string]: any;
}

const { href, external, class: className, underline, ...props } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : '_self'}
  class={cn(
    'inline-block',
    underline && 'hover:underline underline-offset-[3px]',
    className,
  )}
  {...props}
>
  <slot />
</a>
