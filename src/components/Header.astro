---
import { ThemeToggle } from '@/components/theme-toggle.tsx';
import Link from './Link.astro';
import Face from '@/components/Face.astro';
---

<header
  transition:persist
  class="mx-auto flex w-full max-w-3xl items-center justify-between px-4 py-3"
>
  <Link
    href="/"
    class="text-logo-foreground flex items-center gap-x-4 text-xl leading-none font-semibold"
  >
    <Face class="md:hidden" size="small" />
    <p>Jeroen Druwé</p>
  </Link>
  <ThemeToggle client:load />
</header>
