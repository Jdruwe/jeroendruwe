---
/**
 * An amount of in-game money, shown the WoW way: `32 (gold coin) 5 (silver
 * coin) 1 (copper coin)`. Parts that are zero are left out.
 */
interface Props {
  gold?: number;
  silver?: number;
  copper?: number;
}

const { gold = 0, silver = 0, copper = 0 } = Astro.props;

const parts = [
  { amount: gold, metal: 'gold' },
  { amount: silver, metal: 'silver' },
  { amount: copper, metal: 'copper' },
].filter((part) => part.amount > 0);

const label = parts.map((part) => `${part.amount} ${part.metal}`).join(' ');
---

<style>
  .money {
    display: inline-flex;
    gap: 0.35em;
    font-weight: 600;
    white-space: nowrap;
  }

  .money-part {
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
  }

  .coin {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border-radius: 50%;
    box-shadow:
      inset 0 -1px 1px rgb(0 0 0 / 0.35),
      0 0 0 1px rgb(0 0 0 / 0.45);
  }

  .gold {
    background: radial-gradient(
      circle at 35% 30%,
      #fff5b8,
      #f0c419 45%,
      #9a6b00
    );
  }

  .silver {
    background: radial-gradient(
      circle at 35% 30%,
      #ffffff,
      #c3c6cf 45%,
      #6c707c
    );
  }

  .copper {
    background: radial-gradient(
      circle at 35% 30%,
      #ffd2ad,
      #c8702f 45%,
      #6f3610
    );
  }
</style>

<span class="money" role="img" aria-label={label}>
  {
    parts.map((part) => (
      <span class="money-part">
        {part.amount}
        <span class:list={['coin', part.metal]} />
      </span>
    ))
  }
</span>
