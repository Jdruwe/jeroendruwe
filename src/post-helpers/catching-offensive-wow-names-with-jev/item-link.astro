---
import './wow.css';

/**
 * A WoW chat-style item link: `[Item Name]` in its quality colour, with an
 * in-game style tooltip on hover or focus. Without `href` it renders as
 * focusable text instead of a link.
 */

/** Item qualities; their colours are defined in the <style> block below */
type Quality =
  | 'poor'
  | 'common'
  | 'uncommon'
  | 'rare'
  | 'epic'
  | 'legendary'
  | 'artifact';

/** A line of text, or a [left, right] pair like "Two-Hand ... Mace" */
type TooltipLine = string | [string, string];

interface Props {
  name: string;
  href?: string;
  quality?: Quality;
  /** White lines under the name, e.g. "Binds when picked up" */
  lines?: TooltipLine[];
  /** Green lines, e.g. "Use: ..." or "Equip: ..." */
  effects?: string[];
  /** Yellow, quoted flavour text at the bottom */
  flavor?: string;
}

const {
  name,
  href,
  quality = 'legendary',
  lines = [],
  effects = [],
  flavor,
} = Astro.props;

const Tag = href ? 'a' : 'span';
const tooltipId = `item-tooltip-${crypto.randomUUID().slice(0, 8)}`;

// The markup below has no whitespace between tags on purpose: whitespace would
// render as stray spaces around the link, and could wrap onto the next line and
// pull the tooltip down with it.
---

<script>
  // Nudge tooltips sideways so they never run off the edge of the screen
  const MARGIN = 8;

  function keepOnScreen(wrapper: Element, retry = true) {
    const tooltip = wrapper.querySelector<HTMLElement>('.item-tooltip');
    if (!tooltip) return;

    // Hidden tooltips have no size yet. If we measured a moment too early
    // (right as it opens), try once more on the next frame.
    const width = tooltip.offsetWidth;
    if (width === 0) {
      if (retry) requestAnimationFrame(() => keepOnScreen(wrapper, false));
      return;
    }

    // Where the tooltip would start without a shift: the start of the link
    const left = wrapper.getClientRects()[0].left;
    const right = left + width;
    const maxRight = document.documentElement.clientWidth - MARGIN;

    let shift = 0;
    if (right > maxRight) shift = maxRight - right;
    if (left + shift < MARGIN) shift = MARGIN - left;
    tooltip.style.setProperty('--shift', `${shift}px`);
  }

  function setup() {
    document.querySelectorAll('.item-link-wrapper').forEach((wrapper) => {
      const update = () => keepOnScreen(wrapper);
      wrapper.addEventListener('pointerenter', update);
      wrapper.addEventListener('focusin', update);
    });
  }

  // The site uses Astro's ClientRouter, which fires this on every page view
  document.addEventListener('astro:page-load', setup);

  // When the screen size changes (resizing, rotating a phone), reposition any
  // open tooltip. Closed ones have no size and are skipped. At most once per
  // frame, however many resize events fire.
  let resizeQueued = false;
  window.addEventListener('resize', () => {
    if (resizeQueued) return;
    resizeQueued = true;
    requestAnimationFrame(() => {
      resizeQueued = false;
      document
        .querySelectorAll('.item-link-wrapper')
        .forEach((wrapper) => keepOnScreen(wrapper, false));
    });
  });
</script>

<style>
  .item-link-wrapper {
    position: relative;
    display: inline;
  }

  /*
   * Quality colours: --quality is the in-game colour (used on dark pages and
   * in the tooltip), --quality-light a darker shade that stays readable on
   * white.
   */

  /* Legendary, also the default */
  .item-link-wrapper {
    --quality: #ff8000;
    --quality-light: #b35900;
  }

  .item-link-wrapper[data-quality='poor'] {
    --quality: #9d9d9d;
    --quality-light: #6b6b6b;
  }

  .item-link-wrapper[data-quality='common'] {
    --quality: #ffffff;
    --quality-light: #3a3a3a;
  }

  .item-link-wrapper[data-quality='uncommon'] {
    --quality: #1eff00;
    --quality-light: #178a00;
  }

  .item-link-wrapper[data-quality='rare'] {
    --quality: #0070dd;
    --quality-light: #0058b0;
  }

  .item-link-wrapper[data-quality='epic'] {
    --quality: #a335ee;
    --quality-light: #7b2cbf;
  }

  .item-link-wrapper[data-quality='artifact'] {
    --quality: #e6cc80;
    --quality-light: #8a7433;
  }

  .item-link {
    color: var(--quality-light);
    font-family: var(--wow-font);
    font-size: 1.05em;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  :global(.dark) .item-link {
    color: var(--quality);
  }

  a.item-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .item-link:focus-visible {
    outline: 2px solid var(--quality);
    outline-offset: 2px;
    border-radius: 2px;
  }

  span.item-link:focus {
    outline: none;
  }

  /* Classic WoW tooltip: dark navy fill, rounded grey border */
  .item-tooltip {
    --shift: 0px;

    position: absolute;
    top: calc(100% + 6px);
    /* --shift is set by the script to keep the tooltip on screen. It moves the
       real layout position (not a transform), so the page never gets wider. */
    left: var(--shift);
    z-index: 30;
    flex-direction: column;
    gap: 0.1rem;
    width: max-content;
    max-width: min(20rem, calc(100vw - 16px));
    padding: 0.5rem 0.7rem;
    color: #fff;
    font-family: var(--wow-font);
    font-size: 0.875rem;
    line-height: 1.35;
    text-align: left;
    white-space: normal;
    text-shadow: 1px 1px 0 #000;
    background: rgb(4 4 18 / 0.97);
    border: 2px solid #9ea3ad;
    border-radius: 5px;
    box-shadow:
      inset 0 0 0 1px #000,
      0 0 0 1px #000,
      0 6px 16px rgb(0 0 0 / 0.5);

    /*
     * Hidden until hover or focus. display: none (not just invisible) so a
     * hidden tooltip near the right edge can't make the page scroll sideways.
     * allow-discrete keeps the fade working while display switches.
     */
    display: none;
    opacity: 0;
    translate: 0 -2px;
    transition:
      opacity 120ms,
      translate 120ms,
      display 120ms allow-discrete;
    pointer-events: none;
  }

  /* Links show it on keyboard focus; plain items also on tap/click */
  .item-link-wrapper:hover .item-tooltip,
  a.item-link:focus-visible + .item-tooltip,
  span.item-link:focus + .item-tooltip {
    display: flex;
    opacity: 1;
    translate: 0 0;
  }

  /* Where the fade-in starts from when the tooltip appears */
  @starting-style {
    .item-link-wrapper:hover .item-tooltip,
    a.item-link:focus-visible + .item-tooltip,
    span.item-link:focus + .item-tooltip {
      opacity: 0;
      translate: 0 -2px;
    }
  }

  .item-tooltip-name {
    color: var(--quality);
    font-size: 1rem;
  }

  .item-tooltip-pair {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .item-tooltip-effect {
    color: #1eff00;
  }

  .item-tooltip-flavor {
    color: #ffd100;
  }

  @media (prefers-reduced-motion: reduce) {
    .item-tooltip {
      transition: none;
    }
  }
</style>

<span class="item-link-wrapper not-prose" data-quality={quality}
  ><Tag
    class="item-link"
    href={href}
    tabindex={href ? undefined : 0}
    aria-describedby={tooltipId}
    ><span aria-hidden="true">[</span>{name}<span aria-hidden="true">]</span
    ></Tag
  ><span class="item-tooltip" id={tooltipId} role="tooltip"
    ><span class="item-tooltip-name">{name}</span>{
      lines.map((line) =>
        Array.isArray(line) ? (
          <span class="item-tooltip-pair">
            <>
              <span>{line[0]}</span>
              <span>{line[1]}</span>
            </>
          </span>
        ) : (
          <span>{line}</span>
        ),
      )
    }{
      effects.map((effect) => <span class="item-tooltip-effect">{effect}</span>)
    }{flavor && <span class="item-tooltip-flavor">"{flavor}"</span>}</span
  ></span
>
