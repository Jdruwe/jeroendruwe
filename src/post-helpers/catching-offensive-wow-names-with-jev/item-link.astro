---
import './wow.css';
import ItemTooltip from './item-tooltip.astro';
import type { ItemDetails } from './item-types';

/**
 * A WoW chat-style item link: `[Item Name]` in its quality colour, with an
 * in-game style tooltip on hover or focus. Without `href` it renders as
 * focusable text instead of a link.
 */
interface Props extends ItemDetails {
  href?: string;
}

const { href, quality = 'legendary', ...details } = Astro.props;

const Tag = href ? 'a' : 'span';
const tooltipId = `item-tooltip-${crypto.randomUUID().slice(0, 8)}`;

// The markup below has no whitespace between tags on purpose: whitespace would
// render as stray spaces around the link, and could wrap onto the next line and
// pull the tooltip down with it.
---

<script>
  // Nudge tooltips sideways so they never run off the edge of the screen
  const MARGIN = 8;

  function keepOnScreen(wrapper: Element, retry = true) {
    const tooltip = wrapper.querySelector<HTMLElement>('.item-tooltip');
    if (!tooltip) return;

    // Hidden tooltips have no size yet. If we measured a moment too early
    // (right as it opens), try once more on the next frame.
    const width = tooltip.offsetWidth;
    if (width === 0) {
      if (retry) requestAnimationFrame(() => keepOnScreen(wrapper, false));
      return;
    }

    // Where the tooltip would start without a shift: the start of the link
    const left = wrapper.getClientRects()[0].left;
    const right = left + width;
    const maxRight = document.documentElement.clientWidth - MARGIN;

    let shift = 0;
    if (right > maxRight) shift = maxRight - right;
    if (left + shift < MARGIN) shift = MARGIN - left;
    tooltip.style.setProperty('--shift', `${shift}px`);
  }

  function setup() {
    document.querySelectorAll('.item-link-wrapper').forEach((wrapper) => {
      const update = () => keepOnScreen(wrapper);
      wrapper.addEventListener('pointerenter', update);
      wrapper.addEventListener('focusin', update);
    });
  }

  // The site uses Astro's ClientRouter, which fires this on every page view
  document.addEventListener('astro:page-load', setup);

  // When the screen size changes (resizing, rotating a phone), reposition any
  // open tooltip. Closed ones have no size and are skipped. At most once per
  // frame, however many resize events fire.
  let resizeQueued = false;
  window.addEventListener('resize', () => {
    if (resizeQueued) return;
    resizeQueued = true;
    requestAnimationFrame(() => {
      resizeQueued = false;
      document
        .querySelectorAll('.item-link-wrapper')
        .forEach((wrapper) => keepOnScreen(wrapper, false));
    });
  });
</script>

<style>
  .item-link-wrapper {
    position: relative;
    display: inline;
  }

  .item-link {
    color: var(--quality-light);
    font-family: var(--wow-font);
    font-size: 1.05em;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  :global(.dark) .item-link {
    color: var(--quality);
  }

  a.item-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .item-link:focus-visible {
    outline: 2px solid var(--quality);
    outline-offset: 2px;
    border-radius: 2px;
  }

  span.item-link:focus {
    outline: none;
  }

  /* Position the tooltip under the link (its look is in item-tooltip.astro) */
  .item-link-wrapper :global(.item-tooltip) {
    --shift: 0px;

    position: absolute;
    top: calc(100% + 6px);
    /* --shift is set by the script to keep the tooltip on screen. It moves the
       real layout position (not a transform), so the page never gets wider. */
    left: var(--shift);
    z-index: 30;

    /*
     * Hidden until hover or focus. display: none (not just invisible) so a
     * hidden tooltip near the right edge can't make the page scroll sideways.
     * allow-discrete keeps the fade working while display switches.
     */
    display: none;
    opacity: 0;
    translate: 0 -2px;
    transition:
      opacity 120ms,
      translate 120ms,
      display 120ms allow-discrete;
    pointer-events: none;
  }

  /* Links show it on keyboard focus; plain items also on tap/click */
  .item-link-wrapper:hover :global(.item-tooltip),
  a.item-link:focus-visible + :global(.item-tooltip),
  span.item-link:focus + :global(.item-tooltip) {
    display: flex;
    opacity: 1;
    translate: 0 0;
  }

  /* Where the fade-in starts from when the tooltip appears */
  @starting-style {
    .item-link-wrapper:hover :global(.item-tooltip),
    a.item-link:focus-visible + :global(.item-tooltip),
    span.item-link:focus + :global(.item-tooltip) {
      opacity: 0;
      translate: 0 -2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .item-link-wrapper :global(.item-tooltip) {
      transition: none;
    }
  }
</style>

<span class="item-link-wrapper not-prose" data-item-quality={quality}
  ><Tag
    class="item-link"
    href={href}
    tabindex={href ? undefined : 0}
    aria-describedby={tooltipId}
    ><span aria-hidden="true">[</span>{details.name}<span aria-hidden="true"
      >]</span
    ></Tag
  ><ItemTooltip
    id={tooltipId}
    role="tooltip"
    quality={quality}
    {...details}
  /></span
>
