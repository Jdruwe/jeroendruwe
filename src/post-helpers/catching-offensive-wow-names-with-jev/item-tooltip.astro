---
import './wow.css';
import Money from './money.astro';
import type { HTMLAttributes } from 'astro/types';
import type { ItemDetails } from './item-types';

/**
 * The WoW item tooltip box itself: name in its quality colour, white lines,
 * green effects, yellow flavour text and an optional price in coins.
 * With `href`, shows a small footer link labelled `linkLabel`.
 * Used by ItemLink (on hover) and ItemCard (always visible).
 */
interface Props extends ItemDetails {
  id?: string;
  role?: HTMLAttributes<'span'>['role'];
  class?: string;
  href?: string;
  /** Text in front of the link, "Visit" by default */
  linkLabel?: string;
}

const {
  name,
  quality = 'legendary',
  lines = [],
  effects = [],
  flavor,
  price,
  priceLabel = 'Sell Price',
  countUpPrice = false,
  href,
  linkLabel = 'Visit',
  id,
  role,
  class: className,
} = Astro.props;
---

<style>
  /* Classic WoW tooltip: dark navy fill, rounded grey border */
  .item-tooltip {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    width: max-content;
    max-width: min(20rem, calc(100vw - 16px));
    padding: 0.5rem 0.7rem;
    color: #fff;
    font-family: var(--wow-font);
    font-size: 0.875rem;
    line-height: 1.35;
    text-align: left;
    white-space: normal;
    text-shadow: 1px 1px 0 #000;
    background: rgb(4 4 18 / 0.97);
    border: 2px solid #9ea3ad;
    border-radius: 5px;
    box-shadow:
      inset 0 0 0 1px #000,
      0 0 0 1px #000,
      0 6px 16px rgb(0 0 0 / 0.5);
  }

  .item-tooltip-name {
    color: var(--quality);
    font-size: 1rem;
  }

  .item-tooltip-pair {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .item-tooltip-effect {
    color: #1eff00;
  }

  .item-tooltip-flavor {
    color: #ffd100;
  }

  /* Footer link out of the tooltip, kept apart from the effects above it:
     neutral white with an arrow, not another green "Use:" line */
  .item-tooltip-link {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.6rem;
    color: #fff;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .item-tooltip-link .arrow {
    font-size: 1.1em;
    line-height: 1;
  }

  .item-tooltip-link:hover,
  .item-tooltip-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .item-tooltip-link:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .item-tooltip-price {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }

  /* Coins are bold in body text, but not inside a tooltip */
  .item-tooltip-price :global(.money) {
    font-weight: 400;
  }
</style>

<span
  class:list={['item-tooltip', className]}
  id={id}
  role={role}
  data-item-quality={quality}
  ><span class="item-tooltip-name">{name}</span>{
    lines.map((line) =>
      Array.isArray(line) ? (
        <span class="item-tooltip-pair">
          <span>{line[0]}</span>
          <span>{line[1]}</span>
        </span>
      ) : (
        <span>{line}</span>
      ),
    )
  }{effects.map((effect) => <span class="item-tooltip-effect">{effect}</span>)}{
    flavor && <span class="item-tooltip-flavor">"{flavor}"</span>
  }{
    href && (
      <a class="item-tooltip-link" href={href}>
        {linkLabel}<span class="arrow" aria-hidden="true">↗</span>
      </a>
    )
  }{
    price && (
      <span class="item-tooltip-price">
        {priceLabel}: <Money {...price} countUp={countUpPrice} />
      </span>
    )
  }</span
>
