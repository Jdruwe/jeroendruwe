---
import Layout from '../layouts/Layout.astro';
import { getRecentPosts } from '@/lib/collection-utils.ts';
import PostEntry from '@/components/PostEntry.astro';
import face from '../assets/face.jpg';
import { Image } from 'astro:assets';
import { MusicIcon, Music4Icon } from '@lucide/astro';
import PageHead from '@/components/PageHead.astro';

const recentPosts = await getRecentPosts();
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="flex flex-col gap-y-14">
    <div class="flex flex-col items-center gap-3 text-lg md:flex-row">
      <Image
        src={face}
        alt="Jeroen's face"
        class="bg-border size-28 shrink-0 rounded-full border-6 md:size-36"
      />
      <p class="md:order-first">
        <span class="bg-primary text-primary-foreground p-0.5 font-semibold"
          >Software developer</span
        > with broad technical interests. In my spare time, I'm usually spending
        time with my <span class="bg-secondary text-secondary-foreground p-0.5"
          >family</span
        >, tinkering with <span
          class="bg-secondary text-secondary-foreground p-0.5"
          >smart home tech</span
        >,
        <span
          class="bg-secondary text-secondary-foreground p-0.5 whitespace-nowrap"
          ><MusicIcon class="inline size-4" /> playing the piano <Music4Icon
            class="inline size-4"
          /></span
        >, or out on a <span
          class="bg-secondary text-secondary-foreground p-0.5">geocaching</span
        > hunt.
      </p>
    </div>
    <ul class="flex flex-col gap-y-6">
      {
        recentPosts.map((post) => (
          <li>
            <PostEntry entry={post} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
